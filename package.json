{
  "name": "PeoplePay360",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^26.2.0",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "convex": "^1.45.0",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "deploy": "vercel deploy",
    "deploy:check": "vercel deploy --dry",
    "deploy:prod": "vercel deploy --prod",
    "deploy:setup": "vercel link",
    "dev": "turbo run dev",
    "dev:server": "turbo run dev -F @PeoplePay360/backend --",
    "dev:setup": "turbo run dev:setup -F @PeoplePay360/backend --",
    "dev:vercel": "vercel dev -L",
    "dev:web": "turbo run dev -F web --",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@PeoplePay360/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@PeoplePay360/config": "workspace:*",
    "@biomejs/biome": "2.5.9",
    "@types/node": "catalog:",
    "tsx": "^4.23.1",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.10.7",
    "vercel": "^58.1.0"
  },
  "packageManager": "bun@1.3.0"
}
